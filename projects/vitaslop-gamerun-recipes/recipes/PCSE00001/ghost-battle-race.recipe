5240:
5350: touch=960,314
5390:

# Confirm out of the region list and on through whatever the wizard has left.
5550: touch=1870,540
5590:
5750: touch=960,874
5790:
5950: touch=1870,540
5990:
6150: touch=960,874
6190:

# SETTINGS COMPLETE - READY is the big arrow panel at screen (826,276).
6400: touch=1652,552
6440:
6600: touch=1652,552
6640:

# Team trophy + RCTV ticker; the right-edge arrow dismisses it to the MAIN MENU.
7000: touch=1870,540
7040:
7300: touch=1870,540
7340:

# --- from the main menu to a live race --------------------------------------
7500: @section world-race

# MAIN MENU: GARAGE | WORLD RACE | SPOT | TIME. Take WORLD RACE, the card
# centred at screen (727,270).
7500: touch=1454,540
7520:

# RACE SELECTION: Ghost Battle | Online Battle | Face-to-Face Battle. Only
# GHOST BATTLE (screen 240,270) is offline.
7640: touch=480,540
7660:

# GHOST: one entry, "Default Ghost" (screen 572,272). It ships with the title,
# so the list is never empty and needs no download.
7780: touch=1144,544
7800:

# MACHINE: BISARGENTO is the only car owned at LV1. The right-edge arrow
# confirms it.
7920: touch=1870,540
7940:

# CONFIRM: Highland Cliffs / BISARGENTO / Default Ghost, and READY at screen
# (838,275). This is the touch that streams the course in.
8060: touch=1676,550
8080:

# LOADING runs to about f8600; the race is live and accepting input by f8800.
8800: @section race

# ============================================================================
# THE DRIVING LINE BELOW IS RECORDED, NOT AUTHORED.
# It is the response of a closed-loop controller (`drive_ghost.py`) that read the
# car's position and facing from `camera` every four frames and aimed at the far
# end of the ROAD MATERIAL ahead, reported by `surface --tex 0x8c62b500`. Every
# lx value here is an input the car actually received at that frame.
#
# THREE THINGS THAT COST A RUN EACH, ALL MEASURED, ALL WORTH KNOWING BEFORE
# TOUCHING THIS:
#  1. lx ABOVE 128 steers towards +X, which DECREASES the bearing that `camera`
#     and `surface` report (both are math angles in the x/-z plane). Getting the
#     sign backwards drives off the outside of the first corner in nine ticks.
#  2. THE STICK IS DEADZONED AND THE DEADZONE IS MOST OF THE RANGE. Degrees of
#     yaw per 10 frames against deflection from neutral, measured on the start
#     straight: 12 -> 0.0, 27 -> 0.75, 42 -> 10.6, 75 -> ~28. A "gentle
#     correction" of 12 units is not gentle, it is nothing, and a car steered
#     with it holds a dead-straight line into the scenery. That is why almost
#     every value below is either 128 or past 160 / under 90.
#  3. A CARRIED LAP DIRECTION IS NOT OPTIONAL. Road reaches BOTH ways from the
#     car, so a fan aimed at a car that has spun finds the road it came in on and
#     drives a confident lap the WRONG WAY. The controller aims its fan along a
#     course that may only turn 20 degrees per tick, so no single reading can
#     reverse it.
#
# WHERE THIS LINE ENDS, AND WHY. The car drives the start straight, the first
# right-hander and the long sweep out to x~685 - about 420 frames of real racing
# with the ghost's HUD live - and then wedges against the barrier on the tight
# left at (685,-228). `square` is NOT a reverse gear (40 frames of it moved a
# pinned car 0.0 units), so the controller cannot back out of that one, and the
# input is released rather than left thrashing. Completing the lap needs a
# recorded racing line for this circuit, which is the next piece of work.
# ============================================================================

8800: @section drive
