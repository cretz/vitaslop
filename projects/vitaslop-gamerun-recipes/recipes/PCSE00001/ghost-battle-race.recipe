3900: touch=960,878
3940:
4000: touch=960,878
4040:

# Place the marker on the world map and confirm with the right-edge arrow.
4200: touch=960,540
4240:
4400: touch=1870,540
4440:
4600: touch=1870,540
4640:
4800: touch=960,874
4840:
